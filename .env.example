# ------------------------------------------------------------------
# Copia este archivo como  .env  (en la raíz del proyecto) y rellena
# los valores que te da Firebase en:
#   Consola Firebase -> Configuración del proyecto -> Tus apps -> Web
# En Netlify, añade exactamente estas mismas variables en:
#   Site settings -> Environment variables
# ------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Pon "true" SOLO cuando hayas desplegado las Cloud Functions
VITE_USE_CLOUD_FUNCTIONS=false
VITE_FUNCTIONS_REGION=europe-west1
