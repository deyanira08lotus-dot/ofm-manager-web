rules_version = '2';
/**
 * firebase/storage.rules
 * Firebase Console -> Storage -> Reglas -> pegar y publicar.
 * Solo escudos/avatares subidos por el propio usuario, con límite de tamaño y tipo.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isImage() { return request.resource.contentType.matches('image/(png|jpeg|webp)'); }
    function smallEnough() { return request.resource.size < 2 * 1024 * 1024; } // 2 MB

    // Escudo del club: solo el dueño (la carpeta lleva su uid)
    match /clubs/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && isImage() && smallEnough();
    }

    // Avatar del manager
    match /managers/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && isImage() && smallEnough();
    }

    // Recursos generados por el servidor (fotos de plantilla, gráficos, informes)
    match /generated/{allPaths=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
